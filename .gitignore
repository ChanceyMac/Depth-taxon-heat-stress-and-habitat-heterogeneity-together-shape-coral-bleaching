# ---- R session artifacts --------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
.Rapp.history

# ---- brms / cmdstanr / rstan fits (large; regeneratable) -----------------
# Fitted brms objects are typically 50–500 MB each; do not commit.
# The scripts refit models when needed.
*.rds
*.RDS
*.stan                            # generated Stan code
*.hpp                             # compiled C++ intermediates

# ---- Outputs (regenerated by scripts) ------------------------------------
Outputs/*
!Outputs/.gitkeep

# Contrast tables are regenerated; if you'd rather commit them, remove the
# next two lines.
Contr_table_*.csv
*.png
*.pdf
*.svg
*.tiff

# ---- Editor / OS junk -----------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# ---- Logs & scratch -------------------------------------------------------
*.log
scratch/
tmp/
